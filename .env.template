# ──────────────────────────────────────────────────────────────────────────────
# Kgoro — environment variables
# Copy this file to .env and fill in real values before running the app.
# NEVER commit .env to source control (it is in .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# Google Maps — required for the map widget in cab booking.
# Also set GOOGLE_MAPS_API_KEY in android/local.properties (read separately
# by android/app/build.gradle.kts for the Android manifest).
GOOGLE_MAPS_API_KEY=

# PayFast payment gateway
# Set PAYFAST_SANDBOX=true for testing against PayFast sandbox environment.
# Only switch to false (production) with real credentials via CI/CD secrets.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Support contact details shown in the Help & Support screen
SUPPORT_WHATSAPP_NUMBER=
SUPPORT_EMAIL=
