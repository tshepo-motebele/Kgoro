rules_version = '2';

// Deploy with: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    // ── Driver documents (ID, proof of address) ──────────────────────────────
    // Private — only the applicant and admins can see these.
    match /drivers/{uid}/{fileName} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || request.auth.token.admin == true);
      allow write: if request.auth != null && request.auth.uid == uid &&
        request.resource.size < 8 * 1024 * 1024 &&  // 8 MB max
        request.resource.contentType.matches('image/.*');
    }

    // ── Vendor logos / banner images ─────────────────────────────────────────
    // Public reads so customers see store photos.
    // Writes: vendor owner only (verified via Firestore lookup).
    match /vendors/{vendorId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid == firestore.get(
          /databases/(default)/documents/vendors/$(vendorId)
        ).data.ownerId &&
        request.resource.size < 5 * 1024 * 1024 &&  // 5 MB max
        request.resource.contentType.matches('image/.*');
      // Admin can always write
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // ── Vendor product images ─────────────────────────────────────────────────
    match /vendors/{vendorId}/products/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid == firestore.get(
          /databases/(default)/documents/vendors/$(vendorId)
        ).data.ownerId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
